# ==========================================
# Aegis Vault - Environment Configuration
# ==========================================
# Note: Aegis Vault is a client-side zero-knowledge application.
# Encryption, PBKDF2 key derivation, and vault persistence run entirely in your browser.
# No secrets or passwords are sent to any remote server.

# Optional: Port configuration for local dev server (default: 3000)
PORT=3000

# Optional: Public App URL (if hosted on custom domain or Vercel/Netlify/Cloud Run)
VITE_APP_URL="http://localhost:3000"
